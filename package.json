{
    "name": "wmb-table",
    "version": "2.0.0",
    "productName": "Wmb Table",
    "description": "Application de lecture et d'étude des prédications de William Marrion Branham, avec Bible intégrée, notes, synthèse vocale et recherche avancée.",
    "type": "module",
    "main": "./out/main/index.js",
    "author": {
        "name": "Wmb Table Team",
        "email": "paradoxngwasi@gmail.com",
        "url": "https://wmb-table.web.app/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paradoxe35/wmb-table.git"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "package": "electron-vite build && electron-builder --publish never",
        "package:publish": "electron-vite build && electron-builder --publish onTagOrDraft",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
        "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
        "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
        "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "postinstall": "electron-builder install-app-deps",
        "rebuild:electron": "electron-rebuild -f",
        "format": "prettier --write \"**/*.{ts,tsx,jsx,json,css,md}\" --log-level warn",
        "format:check": "prettier --check \"**/*.{ts,tsx,jsx,json,css,md}\"",
        "mirror:release": "bash scripts/mirror-to-github-release.sh",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.71",
        "@ai-sdk/google": "^3.0.64",
        "@ai-sdk/openai": "^3.0.53",
        "@ai-sdk/openai-compatible": "^2.0.41",
        "@ai-sdk/provider": "^3.0.8",
        "@ai-sdk/provider-utils": "^4.0.23",
        "@googleapis/drive": "^20.1.0",
        "@googleapis/oauth2": "^5.0.1",
        "@pngwasi/node-tantivy-binding": "^0.3.4",
        "@sentry/electron": "^7.11.0",
        "@turbodocx/html-to-docx": "^1.20.1",
        "ai": "6.0.141",
        "better-sqlite3": "^12.9.0",
        "drizzle-orm": "^0.45.2",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.8.3",
        "epub": "^2.1.1",
        "google-auth-library": "^10.6.2",
        "i18next": "^25.10.10",
        "lodash": "^4.18.1",
        "mammoth": "^1.12.0",
        "marked": "^17.0.6",
        "node-downloader-helper": "^2.1.11",
        "node-edge-tts": "^1.2.10",
        "p-limit": "^7.3.0",
        "sherpa-onnx": "^1.12.37",
        "tar": "^7.5.13",
        "tokenx": "^1.3.0",
        "turndown": "^7.2.4",
        "unbzip2-stream": "^1.4.3",
        "unpdf": "^1.6.0",
        "yauzl": "^3.3.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@ant-design/icons": "^6.1.1",
        "@electron-toolkit/utils": "^4.0.0",
        "@electron/rebuild": "^4.0.4",
        "@tiptap/core": "^3.22.4",
        "@tiptap/extension-link": "^3.22.4",
        "@tiptap/extension-list": "^3.22.4",
        "@tiptap/extension-placeholder": "^3.22.4",
        "@tiptap/extension-subscript": "^3.22.4",
        "@tiptap/extension-superscript": "^3.22.4",
        "@tiptap/extension-table": "^3.22.4",
        "@tiptap/extension-text-align": "^3.22.4",
        "@tiptap/extension-text-style": "^3.22.4",
        "@tiptap/pm": "^3.22.4",
        "@tiptap/react": "^3.22.4",
        "@tiptap/starter-kit": "^3.22.4",
        "@types/better-sqlite3": "^7.6.13",
        "@types/lodash": "^4.17.24",
        "@types/node": "^22.19.17",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/turndown": "^5.0.6",
        "@types/unbzip2-stream": "^1.4.3",
        "@types/yauzl": "^2.10.3",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "@vitejs/plugin-react": "^5.2.0",
        "antd": "^6.3.6",
        "dayjs": "^1.11.20",
        "drizzle-kit": "^0.31.10",
        "electron": "~40.7.0",
        "electron-builder": "^26.9.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "framer-motion": "^12.38.0",
        "globals": "^16.5.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-i18next": "^16.6.6",
        "react-markdown": "^10.1.0",
        "react-timeago": "^8.3.0",
        "react-virtuoso": "^4.18.5",
        "remark-gfm": "^4.0.1",
        "sass": "^1.99.0",
        "sentencex-wasm": "^0.1.23",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^5.9.3",
        "ua-parser-js": "^2.0.9",
        "use-stick-to-bottom": "^1.1.3",
        "vite": "^7.3.2",
        "vitepress": "2.0.0-alpha.16",
        "vitest": "^4.1.5",
        "zustand": "^5.0.12"
    },
    "build": {
        "productName": "Wmb Table",
        "appId": "org.erb.wmbTable",
        "directories": {
            "buildResources": "resources",
            "output": "release"
        },
        "files": [
            "out/**/*",
            "!node_modules/better-sqlite3/deps/**/*",
            "!node_modules/better-sqlite3/src/**/*",
            "!node_modules/better-sqlite3/binding.gyp",
            "!node_modules/**/*.map",
            "!node_modules/**/*.ts",
            "!node_modules/**/*.md"
        ],
        "extraResources": [
            {
                "from": "drizzle",
                "to": "drizzle"
            },
            {
                "from": "resources/database",
                "to": "database"
            },
            {
                "from": "resources/credentials/google",
                "to": "credentials/google"
            },
            {
                "from": "resources/tts",
                "to": "tts"
            }
        ],
        "afterPack": "scripts/afterPack.cjs",
        "mac": {
            "type": "distribution",
            "hardenedRuntime": true,
            "entitlements": "resources/entitlements.mac.plist",
            "entitlementsInherit": "resources/entitlements.mac.plist",
            "gatekeeperAssess": false
        },
        "dmg": {
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "tar.gz"
            ],
            "category": "Education"
        },
        "publish": {
            "provider": "github",
            "owner": "paradoxe35",
            "repo": "wmb-table"
        }
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix"
        ],
        "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
