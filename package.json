{
    "name": "wmb-table",
    "version": "2.0.0",
    "productName": "Wmb Table",
    "description": "Application de lecture et d'étude des prédications de William Marrion Branham, avec Bible intégrée, notes, synthèse vocale et recherche avancée.",
    "main": "./out/main/index.js",
    "author": {
        "name": "Wmb Table Team",
        "email": "paradoxngwasi@gmail.com",
        "url": "https://wmb-table.web.app/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paradoxe35/wmb-table.git"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "package": "electron-vite build && electron-builder --publish never",
        "package:publish": "electron-vite build && electron-builder --publish onTagOrDraft",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-aliases.mjs tests/e2e/run.ts",
        "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
        "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
        "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
        "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "postinstall": "electron-builder install-app-deps",
        "rebuild:electron": "electron-rebuild -f",
        "format": "prettier --write \"**/*.{ts,tsx,jsx,json,css,md}\" --log-level warn",
        "format:check": "prettier --check \"**/*.{ts,tsx,jsx,json,css,md}\"",
        "catalog:sherpa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-aliases.mjs scripts/build-sherpa-catalog.mjs",
        "mirror:release": "bash scripts/mirror-to-github-release.sh",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.108",
        "@ai-sdk/google": "^4.0.126",
        "@ai-sdk/openai": "^4.0.123",
        "@ai-sdk/openai-compatible": "^3.0.94",
        "@ai-sdk/provider": "^4.0.39",
        "@ai-sdk/provider-utils": "^5.0.83",
        "@googleapis/drive": "^27.1.0",
        "@googleapis/oauth2": "^10.0.1",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "@pngwasi/node-tantivy-binding": "^0.3.4",
        "@sentry/electron": "^8.4.0",
        "@turbodocx/html-to-docx": "^1.23.3",
        "ai": "7.0.181",
        "better-sqlite3": "^13.2.0",
        "drizzle-orm": "^0.45.4",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.11",
        "epub": "^2.1.1",
        "google-auth-library": "11.3.4",
        "i18next": "^27.2.7",
        "is-network-error": "^1.3.2",
        "koffi": "^3.3.8",
        "lodash": "^4.18.1",
        "mammoth": "^1.13.0",
        "marked": "^18.3.0",
        "mpg123-decoder": "^1.0.3",
        "node-downloader-helper": "^2.1.11",
        "node-edge-tts": "^1.2.12",
        "p-limit": "^7.3.3",
        "p-retry": "^9.0.0",
        "sherpa-onnx": "^1.13.8",
        "tar": "^7.5.23",
        "tokenx": "^2.2.1",
        "turndown": "^7.2.5",
        "unbzip2-stream": "^1.4.3",
        "unpdf": "^2.2.2",
        "yauzl": "^3.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@ant-design/icons": "^6.3.4",
        "@electron-toolkit/utils": "^4.0.0",
        "@electron/rebuild": "^4.2.1",
        "@modelcontextprotocol/client": "2.4.0",
        "@tiptap/core": "^3.35.0",
        "@tiptap/extension-find-and-replace": "^3.35.0",
        "@tiptap/extension-link": "^3.35.0",
        "@tiptap/extension-list": "^3.35.0",
        "@tiptap/extension-placeholder": "^3.35.0",
        "@tiptap/extension-subscript": "^3.35.0",
        "@tiptap/extension-superscript": "^3.35.0",
        "@tiptap/extension-table": "^3.35.0",
        "@tiptap/extension-text-align": "^3.35.0",
        "@tiptap/extension-text-style": "^3.35.0",
        "@tiptap/pm": "^3.35.0",
        "@tiptap/react": "^3.35.0",
        "@tiptap/starter-kit": "^3.35.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.7",
        "@types/react": "^19.3.1",
        "@types/react-dom": "^19.3.0",
        "@types/turndown": "^5.0.6",
        "@types/unbzip2-stream": "^1.4.3",
        "@types/yauzl": "^3.4.0",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "@vitejs/plugin-react": "^5.2.0",
        "antd": "^6.7.2",
        "dayjs": "^1.11.23",
        "drizzle-kit": "^0.31.11",
        "electron": "~45.5.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "framer-motion": "^14.14.0",
        "globals": "^17.14.0",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.3",
        "react-markdown": "^10.1.0",
        "react-timeago": "^8.3.0",
        "react-virtuoso": "^4.18.24",
        "remark-gfm": "^4.0.1",
        "sass": "^1.108.2",
        "sentencex-wasm": "^0.1.35",
        "simple-git-hooks": "^2.14.0",
        "typescript": "^6.0.3",
        "ua-parser-js": "^2.0.10",
        "use-stick-to-bottom": "^1.1.6",
        "vite": "^7.3.8",
        "vitepress": "2.0.0-alpha.21",
        "vitest": "^5.1.1",
        "zustand": "^5.1.0"
    },
    "build": {
        "productName": "Wmb Table",
        "appId": "org.erb.wmbTable",
        "directories": {
            "buildResources": "resources",
            "output": "release"
        },
        "files": [
            "out/**/*",
            "!node_modules/better-sqlite3/deps/**/*",
            "!node_modules/better-sqlite3/src/**/*",
            "!node_modules/better-sqlite3/binding.gyp",
            "!node_modules/**/*.map",
            "!node_modules/**/*.ts",
            "!node_modules/**/*.md"
        ],
        "extraResources": [
            {
                "from": "drizzle",
                "to": "drizzle"
            },
            {
                "from": "resources/database",
                "to": "database"
            },
            {
                "from": "resources/credentials/google",
                "to": "credentials/google"
            },
            {
                "from": "resources/tts",
                "to": "tts"
            }
        ],
        "afterPack": "scripts/afterPack.cjs",
        "mac": {
            "type": "distribution",
            "hardenedRuntime": true,
            "entitlements": "resources/entitlements.mac.plist",
            "entitlementsInherit": "resources/entitlements.mac.plist",
            "gatekeeperAssess": false,
            "files": [
                "!node_modules/koffi/**/*"
            ]
        },
        "dmg": {
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "rpm",
                "pacman"
            ],
            "category": "Education",
            "files": [
                "!node_modules/koffi/**/*"
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "paradoxe35",
            "repo": "wmb-table"
        }
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix"
        ],
        "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
