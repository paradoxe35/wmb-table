{
    "name": "wmb-table",
    "version": "2.0.0",
    "productName": "Wmb Table",
    "description": "Gestion livres et prédications",
    "type": "module",
    "main": "./out/main/index.js",
    "author": {
        "name": "Paradoxe Ngwasi",
        "email": "paradoxngwasi@gmail.com",
        "url": "https://pngwasi.me"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paradoxe35/wmb-table.git"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "package": "electron-vite build && electron-builder --publish never",
        "package:publish": "electron-vite build && electron-builder --publish onTagOrDraft",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
        "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
        "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "postinstall": "electron-builder install-app-deps",
        "format": "prettier --write \"**/*.{ts,tsx,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,jsx,json,css,md}\""
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.0",
        "@oxdev03/node-tantivy-binding": "^0.2.0",
        "antd": "^6.3.1",
        "better-sqlite3": "^12.6.2",
        "chokidar": "^5.0.0",
        "drizzle-orm": "^0.45.1",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.8.3",
        "framer-motion": "^12.35.0",
        "googleapis": "^171.4.0",
        "lodash": "^4.17.23",
        "node-html-parser": "^7.1.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@electron-toolkit/utils": "^4.0.0",
        "@electron/notarize": "^3.1.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/lodash": "^4.17.24",
        "@types/node": "^22.19.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-react": "^5.1.4",
        "drizzle-kit": "^0.31.9",
        "electron": "^40.7.0",
        "electron-builder": "^26.8.1",
        "electron-vite": "^5.0.0",
        "eslint": "^9.25.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.0.0",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.3.2",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    },
    "build": {
        "productName": "Wmb Table",
        "appId": "org.erb.wmbTable",
        "directories": {
            "buildResources": "resources",
            "output": "release"
        },
        "files": [
            "out/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/data",
                "to": "data"
            },
            {
                "from": "drizzle",
                "to": "drizzle"
            }
        ],
        "mac": {
            "type": "distribution",
            "hardenedRuntime": true,
            "entitlements": "resources/entitlements.mac.plist",
            "entitlementsInherit": "resources/entitlements.mac.plist",
            "gatekeeperAssess": false
        },
        "dmg": {
            "contents": [
                {
                    "x": 130,
                    "y": 220
                },
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "target": [
                "nsis",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Education"
        },
        "publish": {
            "provider": "github",
            "owner": "paradoxe35",
            "repo": "wmb-table"
        }
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix"
        ],
        "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@oxdev03/node-tantivy-binding",
            "better-sqlite3",
            "electron",
            "esbuild",
            "simple-git-hooks",
            "@parcel/watcher"
        ]
    }
}
