{
    "hosting": {
        "public": "docs/.vitepress/dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "cleanUrls": true,
        "headers": [
            {
                "source": "**/*.@(js|css|woff2|png|jpg|jpeg|svg|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=31536000,immutable"
                    }
                ]
            }
        ]
    }
}
